# Raw SEC zips: large, downloaded manually, never committed (keep the folder)
data/raw/*
!data/raw/.gitkeep

# Interim tables: regenerated by the notebooks (keep the folder)
data/interim/*
!data/interim/.gitkeep

# Virtual environment
.venv/

# Jupyter and Python caches
.ipynb_checkpoints/
__pycache__/
*.pyc
